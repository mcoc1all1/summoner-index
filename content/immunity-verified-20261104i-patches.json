        {
          "effectId": "regen-rate-mod",
          "availability": "always",
          "forms": [
            "effect"
          ],
          "condition": "Daredevil (Hell's Kitchen) begins with a 40% Base Regeneration Rate and is immune to regeneration-rate modifications except those caused by Poison. The exception is material for healing-reversal matchups.",
