            "immunity-sinister-specific-20261104"
          ],
          "checkedAt": "2026-11-04"
        }
      ]
    },
    {
      "id": "kingpin",
      "addProtections": [
        {
          "effectId": "regen-rate-mod",
          "availability": "always",
          "forms": [
            "effect"
          ],
          "condition": "Kingpin's Regeneration Rate is set to 50% at fight start and is immune to modification from outside effects except Poison. Poison remains able to change his rate; do not describe this as immunity to Poison or every form of regeneration manipulation.",
          "sourceIds": [
            "immunity-kingpin-specific-20261104"
          ],
          "checkedAt": "2026-11-04"
        }
      ]
    },
    {
      "id": "daredevil-hells-kitchen",
