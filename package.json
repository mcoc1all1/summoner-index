{
  "name": "summoner-index",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/run-with-accuracy-patches.mjs node scripts/build-with-profile.mjs",
    "test": "node scripts/run-with-accuracy-patches.mjs node --test tests/*.test.mjs",
    "dev": "node scripts/serve.mjs",
    "release:check": "node scripts/run-with-accuracy-patches.mjs node scripts/public-release.mjs --check",
    "build:public": "node scripts/run-with-accuracy-patches.mjs node scripts/public-release.mjs",
    "rights:inventory": "node scripts/source-rights-inventory.mjs",
    "rights:guides": "node scripts/run-with-accuracy-patches.mjs node scripts/rights-review-queue.mjs",
    "rights:check": "node scripts/run-with-accuracy-patches.mjs node scripts/rights-review-queue.mjs --check-integrity",
    "rights:require-cleared": "node scripts/run-with-accuracy-patches.mjs node scripts/rights-review-queue.mjs --require-cleared",
    "enrichment:audit": "node scripts/run-with-accuracy-patches.mjs node scripts/champion-enrichment-tracker.mjs",
    "enrichment:tracker": "node scripts/run-with-accuracy-patches.mjs node scripts/champion-enrichment-tracker.mjs --write"
  },
  "engines": {
    "node": ">=22"
  }
}
